{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://reachinbox-scheduler-api-jvfq.onrender.com/api/:path*"
    },
    {
      "source": "/admin/:path*",
      "destination": "https://reachinbox-scheduler-api-jvfq.onrender.com/admin/:path*"
    },
    {
      "source": "/((?!api/|admin/).*)",
      "destination": "/index.html"
    }
  ]
}

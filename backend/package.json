{
  "name": "reachinbox-backend",
  "version": "1.0.0",
  "private": true,
  "description": "ReachInbox email scheduler API + BullMQ workers",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "worker:once": "node dist/worker-once.js",
    "dev:worker:once": "tsx src/worker-once.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "sender:create": "tsx scripts/create-sender.ts",
    "load-test": "tsx scripts/load-test.ts",
    "keys:generate": "node -e \"const c=require('crypto');console.log('SESSION_SECRET='+c.randomBytes(48).toString('hex'));console.log('ENCRYPTION_KEY='+c.randomBytes(32).toString('hex'))\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@bull-board/api": "^6.21.3",
    "@bull-board/express": "^6.21.3",
    "@elastic/elasticsearch": "8.15",
    "@prisma/client": "^6.19.3",
    "@slack/web-api": "^7.19.0",
    "bullmq": "^5.81.5",
    "connect-redis": "^7.1.1",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "express-session": "^1.19.0",
    "google-auth-library": "^9.15.1",
    "helmet": "^8.3.0",
    "html-to-text": "^9.0.5",
    "ioredis": "^5.11.1",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.10.1",
    "pino": "^9.14.0",
    "pino-pretty": "^13.2.0",
    "sanitize-html": "^2.18.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/express-session": "^1.19.0",
    "@types/html-to-text": "^9.0.4",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^6.4.24",
    "@types/sanitize-html": "^2.16.2",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}

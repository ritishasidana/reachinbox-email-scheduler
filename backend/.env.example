# ---------------------------------------------------------------------------------------------
# ReachInbox backend configuration. Copy to `.env` and fill in. Never commit the real `.env`.
# ---------------------------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
PORT=4000
BACKEND_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173

# ---- Infrastructure (matches docker-compose.yml) ---------------------------------------------
DATABASE_URL=postgresql://reachinbox:reachinbox@localhost:5432/reachinbox?schema=public
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=emails

# ---- Secrets: generate with `npm run keys:generate` -----------------------------------------
# Signs session cookies and Slack OAuth state (>= 32 chars).
SESSION_SECRET=
# 32-byte hex key for AES-256-GCM encryption of SMTP passwords and Slack tokens (64 hex chars).
ENCRYPTION_KEY=

# ---- Google OAuth 2.0 (Google Cloud Console -> APIs & Services -> Credentials) ---------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# ---- Slack OAuth 2.0 (api.slack.com/apps -> OAuth & Permissions) -----------------------------
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Slack requires HTTPS redirect URLs; for local dev use a tunnel, e.g. https://<id>.ngrok-free.app/api/slack/callback
SLACK_REDIRECT_URI=
SLACK_SCOPES=chat:write,chat:write.public,incoming-webhook
# Optional fallback channel ID if the install did not pick one via incoming-webhook.
SLACK_DEFAULT_CHANNEL=

# ---- Scheduler / worker ----------------------------------------------------------------------
# Jobs processed in parallel per worker process.
WORKER_CONCURRENCY=5
# Global floor for spacing between two sends of the same sender (ms).
MIN_EMAIL_DELAY_MS=2000
# Global ceiling for each sender's hourly volume.
MAX_EMAILS_PER_HOUR_PER_SENDER=200
EMAIL_JOB_ATTEMPTS=5
EMAIL_JOB_BACKOFF_MS=10000
# How far ahead the rate limiter searches for a free hour.
RATE_LIMIT_LOOKAHEAD_HOURS=168
MAX_RECIPIENTS_PER_CAMPAIGN=10000
# true: API process also runs the workers (simplest for local dev). false: run `npm run start:worker` separately.
# If unset: true in development, false when NODE_ENV=production.
RUN_WORKERS_IN_API=true
# One-shot worker (`npm run worker:once`, used by the GitHub Actions schedule): max run time and how far
# ahead a delayed job counts as "due".
WORKER_ONCE_MAX_MS=600000
WORKER_ONCE_LOOKAHEAD_MS=120000

# ---- Ethereal SMTP ---------------------------------------------------------------------------
ETHEREAL_SMTP_HOST=smtp.ethereal.email
ETHEREAL_SMTP_PORT=587
# Create an Ethereal sender automatically for a user's first login.
AUTO_PROVISION_ETHEREAL_SENDER=true

# ---- Misc ------------------------------------------------------------------------------------
# Comma-separated Google emails allowed to open Bull Board (/admin/queues). Empty = any logged-in user.
ADMIN_EMAILS=
# Attachments are stored in Postgres; UPLOAD_DIR is only read for older attachments saved to disk.
UPLOAD_DIR=uploads
MAX_ATTACHMENT_BYTES=10485760
